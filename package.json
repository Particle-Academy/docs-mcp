{
  "name": "@particle-academy/docs-mcp",
  "version": "0.2.0",
  "description": "Dev-only MCP server (stdio) that exposes docs from every installed @particle-academy/* package. Configure once in your editor (Claude Code / Cursor / Claude Desktop) and any agent can list, read, and search the docs shipped with your installed fancy-* packages. Not a runtime library — don't import it into application code.",
  "type": "module",
  "bin": {
    "docs-mcp": "dist/cli.js",
    "particle-docs-mcp": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsc -w -p .",
    "prepublishOnly": "tsc -p .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "docs",
    "particle-academy",
    "fancy",
    "ai",
    "agents",
    "claude",
    "cursor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Particle-Academy/docs-mcp.git"
  },
  "homepage": "https://github.com/Particle-Academy/docs-mcp#readme",
  "bugs": "https://github.com/Particle-Academy/docs-mcp/issues",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  }
}
